# Copie este arquivo para .env e preencha os valores no seu ambiente local.
# Nunca publique o token do bot.
DISCORD_TOKEN=
CLIENT_ID=
# Opcional: use o ID do servidor para registrar comandos quase imediatamente.
# Sem este valor, os comandos serão registrados globalmente.
GUILD_ID=
# Cargo autorizado a assumir e encerrar tickets.
STAFF_ROLE_ID=
# Categoria opcional para os canais de ticket.
TICKET_CATEGORY_ID=
# Canal opcional para receber registros de tickets encerrados.
LOG_CHANNEL_ID=
